"use client";
import { Modal } from "react-bootstrap";
import { useState } from "react";
import { FiSettings } from "react-icons/fi";
import "./ScrumBoardPage.css";

export default function ScrumBoardPage() {
  const [expandedBoard, setExpandedBoard] = useState(null);
  const [showModal, setShowModal] = useState(false);
  const [activeSprint, setActiveSprint] = useState(null);
  const [activeTab, setActiveTab] = useState({});
  const [scrumBoards, setScrumBoards] = useState([
    {
      id: 1,
      name: "Scrum Board 1",
      dateRange: "30-11-2025 — 30-1-2026",
      sprints: [
        {
          sprintId: 1,
          name: "Sprint 1",
          stages: ["Development", "QA", "PMG", "Deployment"],
          dateRange: "30-11-2025 — 30-1-2026",
          color: "#20c997",
          bgColor: "#d3f9d8",
        },
        {
          sprintId: 2,
          name: "Sprint 2",
          stages: ["Development", "QA", "PMG", "Deployment"],
          dateRange: "30-11-2025 — 30-1-2026",
          color: "#f08080",
          bgColor: "#ffe0e0",
        },
        {
          sprintId: 3,
          name: "Sprint 3",
          stages: ["Development", "QA", "PMG", "Deployment"],
          dateRange: "30-11-2025 — 30-1-2026",
          color: "#6f42c1",
          bgColor: "#e7d5f5",
        },
        {
          sprintId: 4,
          name: "Sprint 4",
          stages: ["Development", "QA", "PMG", "Deployment"],
          dateRange: "30-11-2025 — 30-1-2026",
          color: "#20c997",
          bgColor: "#d3f9d8",
        },
      ],
    },
  ]);

  const [modalStages, setModalStages] = useState([]);

  const toggleBoard = (id) => {
    setExpandedBoard(expandedBoard === id ? null : id);
  };

  const handleTabClick = (sprintId, stageName) => {
    const defaultTabs = {
      1: "Development",
      2: "QA",
      3: "PMG",
      4: "Deployment",
    };
    const defaultTab = defaultTabs[sprintId];
    if (stageName === defaultTab) {
      setActiveTab({ ...activeTab, [sprintId]: stageName });
    }
  };

  const openSettingsModal = (sprintId) => {
    setActiveSprint(sprintId);
    const selectedSprint = scrumBoards[0].sprints.find(
      (s) => s.sprintId === sprintId
    );
    setModalStages(selectedSprint.stages.map((label, i) => ({ id: i, label })));
    setShowModal(true);
  };

  const handleStageChange = (index, value) => {
    const updated = [...modalStages];
    updated[index].label = value;
    setModalStages(updated);
  };

  const handleAddStage = (index) => {
    const newStage = { id: Date.now(), label: "New Stage" };
    const updated = [...modalStages];
    updated.splice(index + 1, 0, newStage);
    setModalStages(updated);
  };

  const handleRemoveStage = (index) => {
    if (modalStages.length === 1) return;
    setModalStages(modalStages.filter((_, i) => i !== index));
  };

  const handleSaveStages = () => {
    if (!activeSprint) return;
    const updatedBoards = [...scrumBoards];
    const board = updatedBoards[0];
    board.sprints = board.sprints.map((s) =>
      s.sprintId === activeSprint
        ? { ...s, stages: modalStages.map((st) => st.label) }
        : s
    );
    setScrumBoards(updatedBoards);
    setShowModal(false);
  };

  return (
    <div
      className="container-fluid p-4"
      style={{ backgroundColor: "#f8f9fa", minHeight: "100vh" }}
    >
      <h1 className="mb-4">Scrum Boards</h1>

      <div className="row">
        <div className="col-lg-10 offset-lg-1">
          {scrumBoards.map((board) => (
            <div key={board.id} className="mb-3">
              {/* Scrum Board Header */}
              <div
                className="card border-secondary mb-2"
                onClick={() => toggleBoard(board.id)}
                style={{
                  cursor: "pointer",
                  backgroundColor:
                    expandedBoard === board.id ? "#e7f3ff" : "#fff",
                  borderLeft:
                    expandedBoard === board.id
                      ? "4px solid #0d6efd"
                      : "1px solid #dee2e6",
                }}
              >
                <div className="card-body d-flex justify-content-between align-items-center py-3">
                  <h5 className="mb-0">{board.name}</h5>
                  <span className="text-muted">{board.dateRange}</span>
                </div>
              </div>

              {/* Sprints Section */}
              {expandedBoard === board.id && (
                <div className="card border-primary mb-3">
                  <div className="card-body">
                    <div className="d-flex justify-content-between align-items-center mb-4">
                      <h5 className="mb-0">Sprints</h5>
                      <button className="btn btn-outline-secondary btn-sm">
                        + Add new
                      </button>
                    </div>

                    <div className="row">
                      {board.sprints.map((sprint) => {
                        const defaultTabs = {
                          1: "Development",
                          2: "QA",
                          3: "PMG",
                          4: "Deployment",
                        };
                        const defaultTab = defaultTabs[sprint.sprintId];
                        const selectedStage = activeTab[sprint.sprintId];
                        return (
                          <div
                            key={sprint.sprintId}
                            className="col-12 mb-3 position-relative"
                          >
                            {/* Sprint Wrapper */}
                            <div
                              style={{
                                border: `1px solid ${sprint.color}`,
                                borderRadius: "8px",
                                backgroundColor: "#fff",
                                display: "flex",
                                flexDirection: "column",
                              }}
                            >
                              {/* Tabs */}
                              <div
                                style={{
                                  display: "flex",
                                  backgroundColor: "#fff",
                                  borderTopLeftRadius: "8px",
                                  borderTopRightRadius: "8px",
                                  minHeight: "32px",
                                }}
                              >
                                <div
                                  style={{
                                    display: "flex",
                                    width: "50%",
                                    border: `1px solid ${sprint.color}`,
                                    borderBottom: "none",
                                    borderTopLeftRadius: "8px",
                                    borderTopRightRadius: "8px",
                                    overflow: "hidden",
                                  }}
                                >
                                  {sprint.stages.map((stage, idx) => {
                                    const isDefault = stage === defaultTab;
                                    const isSelected =
                                      selectedStage === stage;
                                    const isLast =
                                      idx === sprint.stages.length - 1;
                                    return (
                                      <div
                                        key={idx}
                                        onClick={() =>
                                          handleTabClick(
                                            sprint.sprintId,
                                            stage
                                          )
                                        }
                                        style={{
                                          flex: 1,
                                          padding: "6px 10px",
                                          textAlign: "center",
                                          cursor: isDefault
                                            ? "pointer"
                                            : "not-allowed",
                                          borderRight: isLast
                                            ? "none"
                                            : `1px solid ${sprint.color}`,
                                          backgroundColor: isSelected
                                            ? sprint.bgColor
                                            : "#fff",
                                          color: isSelected
                                            ? sprint.color
                                            : "#333",
                                          fontWeight: isSelected
                                            ? "600"
                                            : "500",
                                          opacity: isDefault ? 1 : 0.5,
                                          fontSize: "13px",
                                          display: "flex",
                                          alignItems: "center",
                                          justifyContent: "center",
                                        }}
                                      >
                                        {stage}
                                      </div>
                                    );
                                  })}
                                </div>
                              </div>

                              {/* Sprint Details */}
                              <div
                                style={{
                                  backgroundColor: sprint.bgColor,
                                  padding: "10px 16px",
                                  display: "flex",
                                  justifyContent: "space-between",
                                  alignItems: "center",
                                  minHeight: "60px",
                                }}
                              >
                                <div
                                  style={{
                                    display: "flex",
                                    alignItems: "center",
                                    gap: "12px",
                                  }}
                                >
                                  <span
                                    style={{
                                      backgroundColor: sprint.color,
                                      width: "4px",
                                      height: "32px",
                                    }}
                                  ></span>
                                  <div>
                                    <p
                                      style={{
                                        margin: "0",
                                        fontSize: "13px",
                                        color: sprint.color,
                                        fontWeight: "600",
                                      }}
                                    >
                                      {sprint.name}
                                    </p>
                                    {selectedStage && (
                                      <p
                                        style={{
                                          margin: "2px 0 0 0",
                                          fontSize: "12px",
                                          color: "#666",
                                        }}
                                      >
                                        {selectedStage}
                                      </p>
                                    )}
                                  </div>
                                </div>
                                <span
                                  style={{ fontSize: "12px", color: "#666" }}
                                >
                                  {sprint.dateRange}
                                </span>
                              </div>
                            </div>

                            {/* Settings Icon */}
                            <div
                              style={{
                                position: "absolute",
                                top: "6px",
                                right: "8px",
                                backgroundColor: "#fff",
                                border: `1px solid ${sprint.color}`,
                                borderRadius: "50%",
                                width: "28px",
                                height: "28px",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                cursor: "pointer",
                              }}
                              onClick={() => openSettingsModal(sprint.sprintId)}
                            >
                              <FiSettings color={sprint.color} size={14} />
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      {/* Modal */}
      <Modal show={showModal} onHide={() => setShowModal(false)} centered>
        <Modal.Header closeButton>
          <Modal.Title>
            <h5 className="m-0">Settings</h5>
          </Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <div className="timeline">
            {modalStages.map((stage, index) => (
              <div key={stage.id} className="timeline-item">
                <div className="timeline-number">{index + 1}</div>
                <div className="timeline-line"></div>
                <div className="timeline-stage">
                  <input
                    type="text"
                    value={stage.label}
                    onChange={(e) => handleStageChange(index, e.target.value)}
                    className="stage-input"
                  />
                  <div style={{ display: "flex", gap: "4px" }}>
                    <button
                      className="stage-add-btn"
                      onClick={() => handleAddStage(index)}
                    >
                      +
                    </button>
                    <button
                      className="stage-add-btn stage-minus-btn"
                      onClick={() => handleRemoveStage(index)}
                    >
                      −
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </Modal.Body>
        <Modal.Footer>
          <button className="btn-cancel" onClick={() => setShowModal(false)}>
            Cancel
          </button>
          <button className="btn-submit" onClick={handleSaveStages}>
            Submit
          </button>
        </Modal.Footer>
      </Modal>
    </div>
  );
}

.modal-header h2 {
  font-size: 20px;
  font-weight: 600;
  color: #2d5f7f;
  margin: 0;
}

.modal-header svg {
  color: #2d5f7f;
}

.modal-content {
  margin-bottom: 30px;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-item {
  display: flex;
  gap: 20px;
  position: relative;
  margin-bottom: 0;
}

.timeline-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid #a8d4e0;
  background-color: #f5f9fb;
  font-weight: 600;
  color: #2d5f7f;
  font-size: 14px;
  flex-shrink: 0;
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: 15px;
  top: 40px;
  width: 2px;
  height: 60px;
  background-color: #a8d4e0;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-stage {
  display: flex;
  gap: 10px;
  align-items: center;
  flex: 1;
  margin-top: 8px;
}

.stage-input {
  flex: 1;
  padding: 10px 16px;
  border: 2px solid #a8d4e0;
  border-radius: 6px;
  background-color: #fff;
  font-size: 14px;
  color: #2d5f7f;
  font-weight: 500;
  cursor: default;
}

.stage-input:focus {
  outline: none;
  border-color: #7eb8d0;
}

.stage-add-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid #a8d4e0;
  background-color: #fff;
  color: #2d5f7f;
  cursor: pointer;
  font-size: 18px;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.stage-add-btn:hover {
  border-color: #7eb8d0;
  background-color: #d0e8f2;
}

/* Add specific styling for minus button */
.stage-minus-btn {
  color: #c0666b;
}

.stage-minus-btn:hover {
  color: #a0444d;
  border-color: #d08888;
}

.modal-footer {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.btn-cancel {
  padding: 10px 24px;
  border: 2px solid #e8a4a4;
  background-color: #ffe8e8;
  color: #c0666b;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-cancel:hover {
  background-color: #ffd6d6;
  border-color: #d08888;
}

.btn-submit {
  padding: 10px 24px;
  border: 2px solid #a8d4a8;
  background-color: #e8f5e8;
  color: #4a9456;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-submit:hover {
  background-color: #d6f0d6;
  border-color: #7eb87e;
}
