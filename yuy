@RestController
@RequestMapping("/api")
public class SafetyStockController {

    @Autowired
    private SafetyStockService safetyStockService;

    @PostMapping("/calculate-ss")
    public double calculateSafetyStock(@RequestBody Map<String, Object> request) {

        String productId = request.get("product_id").toString();
        String locationId = request.get("location_id").toString();
        int duration = Integer.parseInt(request.get("duration").toString());

        return safetyStockService.calculateSafetyStock(productId, locationId, duration);
    }
}

@Service
public class SafetyStockService {

    @Autowired
    private JdbcTemplate jdbcTemplate;

    @Autowired
    private ProjectionService projectionService;

    public double calculateSafetyStock(String productId, String locationId, int duration) {

        // 1. Get Order Coverage directly via JDBC
        String sql = "SELECT ordercov FROM REPLAN_PARAM WHERE location_id = ? AND product_id = ?";

        Double orderCov = jdbcTemplate.queryForObject(
                sql,
                new Object[]{locationId, productId},
                Double.class
        );

        if (orderCov == null) orderCov = 0.0;

        // 2. Get demand map (assuming reviewPlanProjection returns Map<String, Double>)
        Map<String, Double> totalDmd = projectionService
                .reviewPlanProjection(productId, locationId, duration);

        // 3. Total demand
        double sumDemand = totalDmd.values()
                .stream()
                .mapToDouble(Double::doubleValue)
                .sum();

        // 4. Avg daily demand
        double avgDailyDemand = sumDemand / duration;

        // 5. Safety stock
        return orderCov * avgDailyDemand;
    }
}
